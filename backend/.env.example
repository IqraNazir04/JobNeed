# LLM
ANTHROPIC_API_KEY=

# Auth - generate a real random value for anything beyond local dev, e.g.:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Job-board admin panel (/admin on the site) - entirely separate from
# regular user accounts. These two only *seed* the initial admin_accounts
# rows on first startup (comma-separated emails, one shared password) -
# after that, the admin panel itself (add/remove admins, change password,
# turn on two-factor) is the source of truth, and these vars are ignored
# for anyone who already has a row.
ADMIN_EMAILS=
ADMIN_PASSWORD=

# Database
DATABASE_URL=postgresql+psycopg://jobneed:jobneed@localhost:5432/jobneed

# Vector store
CHROMA_PERSIST_DIR=./data/chroma

# Optional source credentials (fill in only for sources you're licensed to use)
INDEED_PUBLISHER_ID=
SERPAPI_API_KEY=
LINKEDIN_API_TOKEN=

# Greenhouse, Lever, and Ashby all run public, unauthenticated job-board
# APIs (no key needed) - comma-separated company board tokens, e.g.
# "gitlab,cloudflare"
GREENHOUSE_BOARDS=gitlab,stripe,airbnb,coinbase,robinhood,asana,figma,discord
LEVER_BOARDS=palantir
ASHBY_BOARDS=ramp,notion,linear

# Company career pages that publish schema.org JobPosting structured data
# (the same markup used for Google for Jobs indexing) - no key needed.
JOBPOSTING_URLS=https://barclays.wd3.myworkdayjobs.com/en-US/External_Career_Site_Barclays/job/Software-Engineer_JR-0000121832-4
